# ─────────────────────────────────────────────────────────────
#  Kairos Discord Bot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ── Bible API ─────────────────────────────────────────────────
# Get a free key at https://scripture.api.bible
BIBLE_API_KEY=

# Bible translation ID (default: KJV)
BIBLE_ID=de4e12af7f28f599-02

# ── Channel names ─────────────────────────────────────────────
# Name of the channel where the daily verse is posted
DAILY_VERSE_CHANNEL=daily-verse

# Name of the channel where bot logs/errors are sent
BOT_LOGS_CHANNEL=bot-logs

# ── Notes ─────────────────────────────────────────────────────
# AI provider credentials (Claude, Gemini, OpenAI, OpenRouter, Groq)
# are configured per-server by a server admin using /ai_setup.
# They are stored in data/ai_config.json — NOT in this file.
